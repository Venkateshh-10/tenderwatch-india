# Server-side only. Never use NEXT_PUBLIC_ for this key.
SERPAPI_API_KEY=

# SQLite file used by Prisma. Safe to keep as a local path.
DATABASE_URL="file:./prisma/dev.db"

# Optional. TenderWatch does not call an LLM for discovery or verdicts.
OPENAI_API_KEY=

# How long a live SerpApi response may be reused. Refresh Live bypasses this.
SEARCH_CACHE_TTL_HOURS=12
